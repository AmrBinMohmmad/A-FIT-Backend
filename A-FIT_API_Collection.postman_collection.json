						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"صدر دجاج مشوي مع أرز وخضار\",\n    \"calories\": 550,\n    \"protein\": 50,\n    \"carbs\": 60,\n    \"fat\": 14,\n    \"meal_type\": \"lunch\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/meal/updateMeal/1",
							"host": [
