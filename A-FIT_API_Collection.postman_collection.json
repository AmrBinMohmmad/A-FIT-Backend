{
	"info": {
		"_postman_id": "a-fit-api-collection-v7",
		"name": "A-FIT API Collection",
		"description": "Complete Postman API Collection for A-FIT (Backend).\nFeatures Passwordless OTP First Authentication (Register & Login) + Full Meal CRUD with automatic Bearer token storage.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1. Register - Request OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Amr Mohammad\",\n    \"email\": \"amr@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Validates name/email, checks that email is NOT already in database, and sends a 6-digit registration OTP to the user's email. Does NOT insert into DB yet."
					},
					"response": []
				},
				{
					"name": "1.1 Register - Duplicate Email Check (422 Error)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Amr Mohammad\",\n    \"email\": \"amr@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Tests sending an email that already exists in MySQL database. Returns 422 with message: 'البريد الإلكتروني مسجل مسبقاً'."
					},
					"response": []
				},
				{
					"name": "2. Verify Register OTP (Creates User & Returns Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"Token auto-saved to {{token}}: \", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"amr@example.com\",\n    \"code\": \"234987\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/verifyRegister",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verifyRegister"
							]
						},
						"description": "Verifies registration OTP (or Master OTP 234987), creates the user in MySQL database, and returns the Bearer Token."
					},
					"response": []
				},
				{
					"name": "3. Resend Register Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"amr@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/resendRegisterCode",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"resendRegisterCode"
							]
						},
						"description": "Resends a new registration OTP code for a pending email."
					},
					"response": []
				},
				{
					"name": "4. Login - Request OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"amr@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Sends a passwordless login OTP (valid for 90 seconds) to an existing user."
					},
					"response": []
				},
				{
					"name": "5. Verify Login OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"Token auto-saved to {{token}}: \", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"amr@example.com\",\n    \"code\": \"234987\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/verifyLogin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verifyLogin"
							]
						},
						"description": "Verifies login OTP (or Master OTP 234987) and returns Bearer Token."
					},
					"response": []
				},
				{
					"name": "6. Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Revokes current user session/token."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Meals CRUD",
			"item": [
				{
