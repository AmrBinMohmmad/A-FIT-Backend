							"mode": "raw",
							"raw": "{\n    \"name\": \"صدر دجاج مشوي مع أرز\",\n    \"calories\": 520,\n    \"protein\": 45,\n    \"carbs\": 55,\n    \"fat\": 12,\n    \"meal_type\": \"lunch\"\n}"
						},
