# Production values for the a-fit-env secret (kubectl -n a-fit create secret generic a-fit-env
# --from-env-file=.env.production). Same keys as .env.example; only the in-cluster hosts differ.
APP_NAME=A-FIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://a-fitness.duckdns.org
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Logs go to the pod's stderr: `kubectl -n a-fit logs deploy/api -c app`
LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=a_fit
DB_USERNAME=afit
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="A-FIT"

SANCTUM_TOKEN_EXPIRATION=43200
TELESCOPE_ENABLED=false
