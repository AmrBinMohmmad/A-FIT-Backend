# A-FIT API — operational environment. Every key here is read by this project's config
# and matters at deploy time (Rakaya D10.22). Secrets are never committed.

# ── App ──
APP_NAME=A-FIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
# Default locale for server-authored strings; Accept-Language overrides per request
# (SetLocaleFromAcceptLanguage, allowlist in config/app.php supported_locales).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=a_fit
DB_USERNAME=afit
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Cache / queue / session (Redis in production; the OTP store and rate limiters
# live in the cache, so it must be shared by every app and queue container) ──
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (OTP codes are e-mailed; use a transactional provider in production) ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum ──
# Minutes a personal access token lives (30 days). The mobile client clears its stored
# token on any 401, so the credential always dies server-side first (Rakaya D2.2).
SANCTUM_TOKEN_EXPIRATION=43200

# ── Development master code ──
# A fixed 6-digit code accepted for any e-mail. Honoured ONLY when APP_ENV is local or
# testing; the API ignores it in every other environment. Never set it on a server.
#DEV_MASTER_OTP=

# ── Telescope (registered only when APP_ENV=local, regardless of this flag) ──
TELESCOPE_ENABLED=false

# ── Docker compose ──
APP_PORT=8000
DOCKER_IMAGE=amromohmmad/a_fit_backend:latest
